# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=3000
# 127.0.0.1 is enough for the Android emulator (it reaches the PC as 10.0.2.2).
# Use 0.0.0.0 to accept a real phone on the same Wi-Fi.
HOST=127.0.0.1

MONGO_URL=mongodb://127.0.0.1:27017/campuspulse

# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed web origins, or * (the mobile app does not need CORS).
CORS_ORIGIN=*

# Number of proxies in front of the API: 1 on Render (see render.yaml), 0 locally.
# Lets the rate limits and the audit log see the real client IP.
TRUST_PROXY=0

# Email (password-reset codes). Leave SMTP_HOST empty to print
# the emails in the server console instead (fine for development).
# Examples: smtp-relay.brevo.com:2525 (Brevo; the only kind that works on Render's
# free plan, which blocks ports 25, 465 and 587), smtp.gmail.com:587 with a Google
# "app password" (local only), or sandbox.smtp.mailtrap.io:2525 to catch test emails.
# Check the settings with: npm run mail:test -- <your address>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CampusPulse <no-reply@campuspulse.test>

# Or Gmail through a Google Apps Script relay, over HTTPS: works where SMTP
# ports are blocked (Render's free plan). Set up in docs/deploy.md › Emails, with
# backend/mail-relay/gmail-relay.gs. When set, it is used instead of SMTP; the
# sender name comes from SMTP_FROM. The secret: at least 16 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=

# Push notifications (Firebase Cloud Messaging). Path to the service account key
# from the Firebase console: Project settings > Service accounts > Generate new
# private key. Relative paths start in backend/. Leave empty to turn push off.
# The key is a secret: never commit it (backend/.gitignore skips
# firebase-service-account.json and *firebase-adminsdk*.json).
# e.g. FIREBASE_SERVICE_ACCOUNT_FILE=firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_FILE=

# AI features (OpenRouter, https://openrouter.ai/keys): one API key for many
# models. Leave OPENROUTER_API_KEY empty to turn AI off: every feature then works
# without it (rules only, or "not available right now").
OPENROUTER_API_KEY=
# One model, or several separated by commas: tried in order when one is busy,
# down or slow. Empty: nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free
# (free: about 50 requests a day without credits, 20 a minute).
OPENROUTER_MODEL=
# false (default): requests only go to providers that neither store nor train
# on them. The free models need true (they may keep what is sent).
OPENROUTER_ALLOW_DATA_COLLECTION=false
