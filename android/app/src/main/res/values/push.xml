<?xml version="1.0" encoding="utf-8"?>
<!-- Push notifications (FCM). -->
<resources>
    <!-- AppColors.primary. Tints the small icon in the notification shade. -->
    <color name="campuspulse_primary">#6949A8</color>

    <!-- The channel every push goes to (created in MainActivity). Users see
         its name in Settings > Apps > CampusPulse > Notifications. -->
    <string name="campus_updates_channel_id" translatable="false">campus_updates</string>
    <string name="campus_updates_channel_name">Campus updates</string>
    <string name="campus_updates_channel_description">Account changes, sign-ups and campus news from CampusPulse.</string>

    <!-- 15 min before each class or exam. The API sends these to this
         channel (CLASS_REMINDERS_CHANNEL in backend class-reminders.ts). -->
    <string name="class_reminders_channel_id" translatable="false">class_reminders</string>
    <string name="class_reminders_channel_name">Class reminders</string>
    <string name="class_reminders_channel_description">A reminder 15 minutes before each class or exam of your timetable.</string>
</resources>
